# Copia este archivo como deploy/.env y rellena los valores. Nunca subas .env a git.

# Contraseña de la base de datos Postgres del contenedor "db". Invéntate una
# fuerte, no hace falta recordarla (Docker la guarda en el volumen db_data).
# No uses el carácter "$" en ella (por cómo Docker Compose compone la URL).
POSTGRES_PASSWORD=cambia-esto

# Tu clave de la API de Claude (Fase 6). Déjala vacía si todavía no la tienes.
ANTHROPIC_API_KEY=

# "localhost" (o déjalo así) para probar en local sin HTTPS. Cuando tengas un
# dominio apuntando por DNS a este servidor, pon aquí ese dominio
# (p. ej. broker.midominio.com) y Caddy sacará el certificado HTTPS solo.
DOMAIN=localhost

# Login de la app (usuario único). El usuario tal cual, pero la contraseña va
# como hash bcrypt, nunca en claro: genera el hash con (ver deploy/LEEME.md):
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext 'tu-contraseña'
BASIC_AUTH_USER=antonio
BASIC_AUTH_HASH=pega-aqui-el-hash-que-te-imprima-el-comando-anterior
